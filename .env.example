# ── Equipment Maintenance Triage Assistant ─────────────────────────────
# Copy to .env for local use. NEVER commit real keys (.env is gitignored).
# Only placeholder names live in this file.

# Gemini (optional).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Provider switch: gemini (default) or openrouter. The active provider's key
# is used; local rules + retrieval run first either way.
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys). Works with free-tier :free models.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Cheap + reliable default;
# use a :free id only if you have no OpenRouter credit.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Data directory for SQLite DB, knowledge-base JSON and JSON log files.
DATA_DIR=./data

# Set to 1 to disable file logging (console only). Used by the test suite.
TRIAGE_LOG_DISABLE=
